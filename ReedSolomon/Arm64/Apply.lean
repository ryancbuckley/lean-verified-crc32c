private theorem apply_decode_ok : checkWordsAux applyWords applyInsn 117 = true := rfl

/-- The 117 instruction words of `leanrs_apply` are loaded at `base`. -/
def ApplyLoaded (code : UInt64 → Option UInt32) (base : UInt64) : Prop :=
  ∀ idx (h : idx < applyWords.size), code (base + (4 * idx).toUInt64) = some applyWords[idx]

theorem step_apply {code : UInt64 → Option UInt32} {base : UInt64}
    (hc : ApplyLoaded code base) (idx : Nat) (s : Arm64.ArmState)
    (hpc : s.pc = base + (4 * idx).toUInt64)
    (hok : decide (idx < 117) = true := by decide) :
    Arm64.step code s = Arm64.execInstr s (applyInsn idx) := by
  have hp := of_decide_eq_true hok
  have hsz : idx < applyWords.size := by rw [applyWords_size]; exact hp
  have hfetch := hc idx hsz
  rw [← hpc] at hfetch
  exact Arm64.step_of_decoded hfetch
    (checkWordsAux_spec applyWords applyInsn 117 apply_decode_ok idx hsz hp)

/-! ### What the accumulators hold -/

/-- The accumulator for the 16 bytes at offset `o` of an output row whose
tables start at table offset `t0`, after the first `i` inputs. -/
def accV (T : Nat → UInt8) (D : Nat → Nat → UInt8) (t0 o : Nat) : Nat → V128
  | 0 => Model.vdupq_n_u8 0
  | i + 1 => mulStep (accV T D t0 o i) (vec T (t0 + 32 * i)) (vec T (t0 + 32 * i + 16))
      (vec (D i) o)

/-! ### Address arithmetic and load facts in the shapes the steps produce -/

theorem off1 (p : UInt64) (w a : Nat) : p + w.toUInt64 + a.toUInt64 = p + (w + a).toUInt64 :=
  add_add_nat p w a

theorem off2 (p : UInt64) (w a b : Nat) :
    p + w.toUInt64 + a.toUInt64 + b.toUInt64 = p + (w + a + b).toUInt64 := by
  rw [add_add_nat, add_add_nat, Nat.add_assoc]

section
variable {m0 : Arm64.Mem} {tab inP outP : UInt64} {k r L : Nat} {T : Nat → UInt8}
  {src dst : Nat → UInt64} {D : Nat → Nat → UInt8} {B : Nat → Nat → UInt8}
  {pre : Nat → Nat} {m : Arm64.Mem}

theorem rdDataE (hs : Setup m0 tab inP outP k r L T src dst D) (hg : Good m0 dst r L B pre m)
    {i : Nat} (hi : i < k) {off : Nat} (ho : off + 16 ≤ L) {a : UInt64}
    (ha : a = src i + off.toUInt64) : m.readV128LE a = some (vec (D i) off) := by
  rw [ha]; exact rdData hs hg hi ho

theorem rdTabE (hs : Setup m0 tab inP outP k r L T src dst D) (hg : Good m0 dst r L B pre m)
    {t : Nat} (ht : t + 16 ≤ 32 * k * r) {a : UInt64}
    (ha : a = tab + t.toUInt64) : m.readV128LE a = some (vec T t) := by
  rw [ha]; exact rdTab hs hg ht

end

section
variable {m0 : Arm64.Mem} {tab inP outP : UInt64} {k r L : Nat} {T : Nat → UInt8}
  {src dst : Nat → UInt64} {D : Nat → Nat → UInt8} {B : Nat → Nat → UInt8}
  {pre : Nat → Nat} {m : Arm64.Mem}

/-- The four 16-byte stores of one 64-byte block of output row `j`, at the
addresses the two `stp` instructions use, and the invariant afterwards. -/
theorem row_store (hs : Setup m0 tab inP outP k r L T src dst D) (hg : Good m0 dst r L B pre m)
    {j : Nat} (hj : j < r) {w : Nat} (hw : w + 64 ≤ L) (hop : w ≤ pre j)
    {x8 : UInt64} (hx8 : x8 = w.toUInt64) {v0 v1 v2 v3 : V128}
    (h0 : v0 = vec (B j) w) (h1 : v1 = vec (B j) (w + 16))
    (h2 : v2 = vec (B j) (w + 32)) (h3 : v3 = vec (B j) (w + 48)) :
    ∃ m1 m2 m3 m4, m.writeV128LE (dst j + x8) v0 = some m1 ∧
      m1.writeV128LE (dst j + (x8 + 16)) v1 = some m2 ∧
      m2.writeV128LE (dst j + (x8 + 32)) v2 = some m3 ∧
      m3.writeV128LE (dst j + (x8 + (32 + 16))) v3 = some m4 ∧
      Good m0 dst r L B (fun j' => if j' = j then max (pre j') (w + 64) else pre j') m4 := by
  subst hx8 h0 h1 h2 h3
  have a1 : dst j + (w.toUInt64 + 16) = dst j + (w + 16).toUInt64 := by
    rw [← UInt64.add_assoc]; exact off1 _ w 16
  have a2 : dst j + (w.toUInt64 + 32) = dst j + (w + 32).toUInt64 := by
    rw [← UInt64.add_assoc]; exact off1 _ w 32
  have a3 : dst j + (w.toUInt64 + (32 + 16)) = dst j + (w + 48).toUInt64 := by
    rw [← UInt64.add_assoc]; exact off1 _ w 48
  rw [a1, a2, a3]
  have g1 := good_st16 hs hg hj (off := w) (by omega) hop
  have g2 := good_st16 hs g1 hj (off := w + 16) (by omega) (by simp)
  have g3 := good_st16 hs g2 hj (off := w + 32) (by omega) (by simp)
  have g4 := good_st16 hs g3 hj (off := w + 48) (by omega) (by simp)
  refine ⟨_, _, _, _, write16 hs hg hj (by omega) _, write16 hs g1 hj (by omega) _,
    write16 hs g2 hj (by omega) _, write16 hs g3 hj (by omega) _, g4.congr fun j' _ => ?_⟩
  by_cases h : j' = j
  · simp only [h, ite_true]; omega
  · simp only [h, ite_false]

end

theorem toNat_toUInt64 {n : Nat} (hn : n < 2 ^ 64) : n.toUInt64.toNat = n := by
  simp only [Nat.toUInt64, UInt64.toNat_ofNat']
  exact Nat.mod_eq_of_lt hn

theorem toUInt64_bne_one {n : Nat} (hn : n < 2 ^ 64) (h : n ≠ 1) : (n.toUInt64 != 1) = true := by
  rw [bne_iff_ne]
  intro e
  have := congrArg UInt64.toNat e
  simp only [Nat.toUInt64, UInt64.toNat_ofNat'] at this
  rw [Nat.mod_eq_of_lt hn] at this
  exact h this

theorem sub_one_toUInt64 {n : Nat} (hn : n < 2 ^ 64) (h : 1 ≤ n) :
    n.toUInt64 - 1 = (n - 1).toUInt64 :=
  nat_sub_toUInt64 n 1 h hn

/-! ### The two-row input loop (`idx = 20..60`) -/

section
variable {code : UInt64 → Option UInt32} {base : UInt64}
  {m0 : Arm64.Mem} {tab inP outP : UInt64} {k r L : Nat} {T : Nat → UInt8}
  {src dst : Nat → UInt64} {D : Nat → Nat → UInt8} {B : Nat → Nat → UInt8}
  {pre : Nat → Nat} {mem : Arm64.Mem}

theorem pair_loop (hc : ApplyLoaded code base)
    (hs : Setup m0 tab inP outP k r L T src dst D) (hg : Good m0 dst r L B pre mem)
    {P : Arm64.ArmState → Prop} {w t0 t1 : Nat} (hw : w + 64 ≤ L)
    (ht0 : t0 + 32 * k ≤ 32 * k * r) (ht1 : t1 + 32 * k ≤ 32 * k * r) (sp : UInt64) :
    ∀ (rem i : Nat) (regs : Arm64.RegFile) (simd : Arm64.SimdFile) (nzcv : Arm64.PState),
      k - i = rem → i < k →
      regs.x8 = w.toUInt64 →
      regs.x9 = tab + (t0 + 32 * i).toUInt64 →
      regs.x12 = tab + (t1 + 32 * i).toUInt64 →
      regs.x13 = inP + (8 * i).toUInt64 →
      regs.x14 = (k - i).toUInt64 →
      simd.v28 = Model.vdupq_n_u8 15 →
      simd.v0 = accV T D t0 w i → simd.v1 = accV T D t0 (w + 16) i →
      simd.v2 = accV T D t0 (w + 32) i → simd.v3 = accV T D t0 (w + 48) i →
      simd.v4 = accV T D t1 w i → simd.v5 = accV T D t1 (w + 16) i →
      simd.v6 = accV T D t1 (w + 32) i → simd.v7 = accV T D t1 (w + 48) i →
      (∀ (x15 : UInt64) (nz : Arm64.PState) (u16 u17 u18 u19 u20 u21 u22 u23 u24 u25 u26 u27
          u29 u30 : V128),
        ∃ n s', Arm64.run code n
          { regs := { regs with x9 := tab + (t0 + 32 * k).toUInt64,
                                x12 := tab + (t1 + 32 * k).toUInt64,
                                x13 := inP + (8 * k).toUInt64, x14 := 0, x15 := x15 },
            sp := sp,
            simd := { simd with
              v0 := accV T D t0 w k, v1 := accV T D t0 (w + 16) k,
              v2 := accV T D t0 (w + 32) k, v3 := accV T D t0 (w + 48) k,
              v4 := accV T D t1 w k, v5 := accV T D t1 (w + 16) k,
              v6 := accV T D t1 (w + 32) k, v7 := accV T D t1 (w + 48) k,
              v16 := u16, v17 := u17, v18 := u18, v19 := u19, v20 := u20, v21 := u21,
              v22 := u22, v23 := u23, v24 := u24, v25 := u25, v26 := u26, v27 := u27,
              v28 := Model.vdupq_n_u8 15, v29 := u29, v30 := u30 },
            nzcv := nz, pc := base + 244, mem := mem } = some s' ∧ P s') →
      ∃ n s', Arm64.run code n
        { regs := regs, sp := sp, simd := simd, nzcv := nzcv, pc := base + 80, mem := mem }
          = some s' ∧ P s' := by
  intro rem
  induction rem using Nat.strong_induction_on with
  | _ rem ih =>
    intro i regs simd nzcv hrem hi hx8 hx9 hx12 hx13 hx14 hv28 hv0 hv1 hv2 hv3 hv4 hv5 hv6 hv7 cont
    have f20 : mem.readU64LE regs.x13 = some (src i) := by rw [hx13]; exact rdIn hs hg hi
    have f23a := rdDataE hs hg hi (off := w) (by omega) (a := src i + regs.x8) (by rw [hx8])
    have f23b := rdDataE hs hg hi (off := w + 16) (by omega) (a := src i + regs.x8 + 16)
      (by rw [hx8]; exact off1 _ w 16)
    have f24a := rdDataE hs hg hi (off := w + 32) (by omega) (a := src i + regs.x8 + 32)
