      Good m0 dst r L B (fun _ => c) mem →
      regs.x0 = tab → regs.x1 = inP → regs.x2 = outP → regs.x3 = k.toUInt64 →
      regs.x4 = r.toUInt64 → regs.x6 = (L - 64).toUInt64 → regs.x7 = (32 * k).toUInt64 →
      regs.x8 = w.toUInt64 → simd.v28 = Model.vdupq_n_u8 15 →
      CalleeSaved s0 { regs := regs, sp := sp, simd := simd, nzcv := nzcv, pc := base + 16,
                       mem := mem } →
      ∃ n s', Arm64.run code n
        { regs := regs, sp := sp, simd := simd, nzcv := nzcv, pc := base + 16, mem := mem }
          = some s' ∧
        s'.pc = s0.regs.x30 ∧ Good m0 dst r L B (fun _ => L) s'.mem ∧ CalleeSaved s0 s' := by
  intro rem
  induction rem using Nat.strong_induction_on with
  | _ rem ih =>
    intro w c regs simd nzcv mem hrem hw hwc hcw hg hx0 hx1 hx2 hx3 hx4 hx6 hx7 hx8 hv28 hcs
    mc_step_ex step_apply hc 4 applyInsn
    mc_step_ex step_apply hc 5 applyInsn
    mc_step_ex step_apply hc 6 applyInsn
    refine row_loop hc hs hw hwc hcw hk hB sp r 0 _ _ _ _ rfl (Nat.zero_le _)
      (hg.congr fun j' _ => by simp) hx1 hx3 hx7 hx8 ?_ ?_ hx4 hv28 ?_
    · show regs.x0 = _
      rw [hx0]; exact (UInt64.add_zero _).symm
    · show regs.x2 = _
      rw [hx2]; exact (UInt64.add_zero _).symm
    intro x9 x10 x11 x12 x13 x14 x15 x16 nz u0 u1 u2 u3 u4 u5 u6 u7 u16 u17 u18 u19 u20 u21 u22 u23 u24 u25 u26 u27 u29 u30 mem' hg'
    mc_step_ex step_apply hc 110 applyInsn
    have hx8n : regs.x8.toNat = w := by rw [hx8]; exact toNat_toUInt64 (by omega)
    have hx6n : regs.x6.toNat = L - 64 := by rw [hx6]; exact toNat_toUInt64 (by omega)
    by_cases hlast : L - 64 ≤ w
    · have hb : regs.x6 ≤ regs.x8 := by rw [UInt64.le_iff_toNat_le, hx8n, hx6n]; exact hlast
      mc_step_ex_with step_apply hc 111 applyInsn [hb]
      mc_step_ex step_apply hc 116 applyInsn
      refine ⟨0, _, Arm64.run_zero _ _, hcs.x30, hg'.congr fun _ _ => by omega, ?_⟩
      exact ⟨hcs.sp, hcs.x19, hcs.x20, hcs.x21, hcs.x22, hcs.x23, hcs.x24,
          hcs.x25, hcs.x26, hcs.x27, hcs.x28, hcs.x29, hcs.x30,
          hcs.d8, hcs.d9, hcs.d10, hcs.d11, hcs.d12, hcs.d13, hcs.d14, hcs.d15⟩
    · have hb : ¬ (regs.x6 ≤ regs.x8) := by rw [UInt64.le_iff_toNat_le, hx8n, hx6n]; exact hlast
      mc_step_ex_with step_apply hc 111 applyInsn [hb]
      mc_step_ex step_apply hc 112 applyInsn
      mc_step_ex step_apply hc 113 applyInsn
      have e8 : regs.x8 + 64 = (w + 64).toUInt64 := by
        rw [hx8]; exact (nat_add_toUInt64 w 64).symm
      have hx8n' : (regs.x8 + 64).toNat = w + 64 := by rw [e8]; exact toNat_toUInt64 (by omega)
      by_cases hfull : w + 64 < L - 64
      · have hb2 : regs.x8 + 64 < regs.x6 := by
          rw [UInt64.lt_iff_toNat_lt, hx8n', hx6n]; exact hfull
        mc_step_ex_with step_apply hc 114 applyInsn [hb2]
        mc_step_ex step_apply hc 115 applyInsn
        exact ih (L - 64 - (w + 64)) (by omega) (w + 64) (w + 64) _ _ _ _ rfl (by omega)
          (Nat.le_refl _) (by omega) hg' hx0 hx1 hx2 hx3 hx4 hx6 hx7 e8 rfl
          ⟨hcs.sp, hcs.x19, hcs.x20, hcs.x21, hcs.x22, hcs.x23, hcs.x24,
          hcs.x25, hcs.x26, hcs.x27, hcs.x28, hcs.x29, hcs.x30,
          hcs.d8, hcs.d9, hcs.d10, hcs.d11, hcs.d12, hcs.d13, hcs.d14, hcs.d15⟩
      · have hb2 : ¬ (regs.x8 + 64 < regs.x6) := by
          rw [UInt64.lt_iff_toNat_lt, hx8n', hx6n]; exact hfull
        mc_step_ex_with step_apply hc 114 applyInsn [hb2]
        mc_step_ex step_apply hc 115 applyInsn
        exact ih (L - 64 - (L - 64)) (by omega) (L - 64) (w + 64) _ _ _ _ rfl (by omega)
          (by omega) (by omega) hg' hx0 hx1 hx2 hx3 hx4 hx6 hx7 hx6 rfl
          ⟨hcs.sp, hcs.x19, hcs.x20, hcs.x21, hcs.x22, hcs.x23, hcs.x24,
          hcs.x25, hcs.x26, hcs.x27, hcs.x28, hcs.x29, hcs.x30,
          hcs.d8, hcs.d9, hcs.d10, hcs.d11, hcs.d12, hcs.d13, hcs.d14, hcs.d15⟩

/-! ### Entry (`idx = 0..3`) and the machine-code theorem in terms of `accV` -/

theorem shl5_toUInt64 (n : Nat) : n.toUInt64 <<< 5 = (32 * n).toUInt64 := by
  apply UInt64.eq_of_toBitVec_eq
  apply BitVec.eq_of_toNat_eq
  simp [Nat.toUInt64, Nat.shiftLeft_eq, Nat.mul_comm]

theorem apply_mc_core (hc : ApplyLoaded code base) {s : Arm64.ArmState}
    (hs : Setup s.mem tab inP outP k r L T src dst D) (hk : 0 < k) (hr : 0 < r) (hL : 64 ≤ L)
    (hL64 : L < 2 ^ 64)
    (hB : ∀ j < r, ∀ o, o + 16 ≤ L → accV T D (32 * k * j) o k = vec (B j) o)
    (hpc : s.pc = base) (hx0 : s.regs.x0 = tab) (hx1 : s.regs.x1 = inP)
    (hx2 : s.regs.x2 = outP) (hx3 : s.regs.x3 = k.toUInt64) (hx4 : s.regs.x4 = r.toUInt64)
    (hx5 : s.regs.x5 = L.toUInt64) :
    ∃ n s', Arm64.run code n s = some s' ∧
      s'.pc = s.regs.x30 ∧ Good s.mem dst r L B (fun _ => L) s'.mem ∧ CalleeSaved s s' := by
  rcases s with ⟨regs, sp, simd, nzcv, pc, mem⟩
  dsimp only at hs hpc hx0 hx1 hx2 hx3 hx4 hx5 ⊢
  subst hpc
  have hL64 : L < 2 ^ 64 := by have := hs.dstB 0 hr; omega
  mc_step_ex step_apply hc 0 applyInsn
  mc_step_ex step_apply hc 1 applyInsn
  mc_step_ex step_apply hc 2 applyInsn
  mc_step_ex step_apply hc 3 applyInsn
  refine block_loop hc hs hk hL hL64 hB
    { regs := regs, sp := sp, simd := simd, nzcv := nzcv, pc := pc, mem := mem } sp
    (L - 64) 0 0 _ _ _ _ (by omega) (by omega) (Nat.le_refl _) (by omega) good_init
    hx0 hx1 hx2 hx3 hx4 ?_ ?_ rfl rfl ?_
  · show regs.x5 - 64 = _
    rw [hx5]; exact nat_sub_toUInt64 L 64 hL hL64
  · show regs.x3 <<< 5 = _
    rw [hx3]; exact shl5_toUInt64 k
  · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
      rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩


end

